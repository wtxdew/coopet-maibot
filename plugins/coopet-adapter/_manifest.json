{
  "manifest_version": 2,
  "id": "wtxdew.coopet-adapter",
  "version": "0.1.0",
  "name": "Coopet 桌宠适配器",
  "description": "让 Coopet 桌宠客户端连上 MaiBot：自起 WebSocket 服务，经消息网关收发主人的私聊消息，并推送思考状态。",
  "author": {"name": "wtxdew", "url": "https://github.com/wtxdew"},
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/wtxdew/coopet-maibot",
    "homepage": "https://github.com/wtxdew/coopet-maibot",
    "documentation": "https://github.com/wtxdew/coopet-maibot/blob/master/plugins/coopet-adapter/README.md",
    "issues": "https://github.com/wtxdew/coopet-maibot/issues"
  },
  "plugin_type": "adapter",
  "host_application": {"min_version": "1.4.3", "max_version": "1.99.99"},
  "sdk": {"min_version": "2.22.0", "max_version": "2.98.99"},
  "dependencies": [
    {"type": "python_package", "name": "aiohttp", "version_spec": ">=3.14,<4"}
  ],
  "capabilities": ["chat.get_all_streams", "config.get"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
