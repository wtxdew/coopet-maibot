{
  "name": "coopet",
  "version": "0.1.0",
  "private": true,
  "description": "A Coo-style desktop pet client whose brain is MaiBot",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:pet": "cd packages/cortico-world-desktop-pet && vitest run",
    "typecheck:pet": "cd packages/cortico-world-desktop-pet && tsc --noEmit",
    "build:pet": "cd packages/cortico-world-desktop-pet && node scripts/build-webui.mjs",
    "dev": "corepack pnpm run build:pet && cd packages/coopet-core && tsx src/main.ts",
    "build:console": "node scripts/build-console.mjs",
    "build:icon": "electron scripts/make-icon.cjs",
    "typecheck:console": "tsc -p tsconfig.console.json",
    "app": "corepack pnpm run build:pet && corepack pnpm run build:console && electron packages/coopet-app",
    "ext": "node scripts/ext.mjs",
    "pack": "node scripts/pack.mjs",
    "test:core": "cd packages/coopet-core && vitest run",
    "typecheck:core": "cd packages/coopet-core && tsc --noEmit",
    "test:app": "cd packages/coopet-app && vitest run",
    "typecheck:app": "cd packages/coopet-app && tsc --noEmit -p ."
  },
  "dependencies": {
    "cortico-provider-coo": "workspace:*",
    "cortico-world-coding-agent-notify": "1.2.0",
    "cortico-world-desktop-pet": "workspace:*",
    "express": "^4.22.3",
    "tsx": "^4.23.15",
    "undici": "7.29.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tailwindcss/cli": "^4.3.5",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "3.1.4",
    "@types/ws": "^8.18.1",
    "electron": "44.4.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "jsdom": "^30.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-textarea-autosize": "^8.5.9",
    "tailwindcss": "^4.3.5",
    "tar-stream": "3.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
